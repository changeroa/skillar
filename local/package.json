{
  "name": "skillar",
  "version": "0.3.5",
  "private": false,
  "description": "Local skill router for coding agents: search your skills, trace how agents use them, and see the flow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changeroa/skillar.git",
    "directory": "local"
  },
  "homepage": "https://github.com/changeroa/skillar/tree/main/local#readme",
  "files": [
    "dist/**/*.js",
    "dist/dashboard",
    "dist/store/**/*.sql",
    "dist/store/task-types.json",
    "packs",
    "docs",
    "src/store/schema.sql",
    "src/store/migrations",
    "src/store/task-types.json",
    "README.md",
    "NOTICE"
  ],
  "type": "module",
  "bin": {
    "skillar": "dist/cli/main.js",
    "gisool": "dist/cli/main.js"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "prebuild": "bun dashboard/design/skillar-theme/build.mjs",
    "dev:dashboard": "bun dev-dashboard.mjs",
    "build": "bun --bun tsc -p tsconfig.json && bun build-cloud.mjs && bun build-dashboard.mjs",
    "build:sidecars": "bun build-sidecars.mjs",
    "typecheck": "bun --bun tsc -p tsconfig.json --noEmit && bun --bun tsc -p dashboard/tsconfig.json",
    "test": "bun test --isolate --parallel=2 --timeout 90000 ./test && bun test ./test/sync-performance.mjs",
    "start": "bun dist/cli/main.js serve"
  },
  "dependencies": {
    "express": "^5.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@stylexjs/stylex": "^0.19.2",
    "@types/bun": "1.4.5",
    "@types/d3-sankey": "^0.12.4",
    "@types/express": "^5.0.5",
    "@types/node": "^24.3.0",
    "@types/prismjs": "1.26.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "d3-sankey": "0.12.3",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.76.0",
    "prismjs": "1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.2"
  }
}
