{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@astryxdesign/core": ["./node_modules/@astryxdesign/core"],
      "@astryxdesign/core/*": ["./node_modules/@astryxdesign/core/dist/*"],
      "@astryxdesign/theme-neutral": ["./node_modules/@astryxdesign/theme-neutral"],
      "@stylexjs/stylex": ["./node_modules/@stylexjs/stylex"],
      "*": ["./node_modules/@types/*", "./node_modules/*"] }
  },
  "include": ["src/dashboard"]
}
