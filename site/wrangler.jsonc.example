{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skillar-site",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-03",
  "vars": {
    "PUBLIC_ORIGIN": "https://skillar.sh",
    "ACTIVITY_ENABLED": "true",
    "ACTIVITY_INGEST_ENABLED": "true",
    "PRIVATE_SKILLS_ENABLED": "false",
    "MCP_ENABLED": "false"
  },
  "services": [
    {
      "binding": "ACTIVITY_SERVICE",
      "service": "skillar-activity-foundation"
    },
    {
      "binding": "MCP_AUTH",
      "service": "skillar-mcp-auth"
    },
    {
      "binding": "MCP_RESOURCE",
      "service": "skillar-mcp"
    }
  ],
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "example-accounts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
