{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gisul-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "SKILLS_BUCKET",
      "bucket_name": "example-skills-bucket"
    }
  ]
}
