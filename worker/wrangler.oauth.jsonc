{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gisul-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "SKILLS_BUCKET",
      "bucket_name": "example-skills-bucket"
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "vars": {
    "SKILLAR_NATIVE_TOOLS": "true",
    "SKILLAR_PUBLIC_URL": "https://skills.example.com",
    "SKILLAR_GITHUB_USER_IDS": "123456",
    "GITHUB_CLIENT_ID": "example-github-client-id"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "routes": [
    {
      "pattern": "skills.example.com",
      "custom_domain": true
    }
  ]
}
