{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skillar-mcp-auth",
  "main": "./src/private-mcp/authorization-server.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "PUBLIC_ORIGIN": "https://skillar.sh", "MCP_ENABLED": "false" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "ratelimits": [{
    "name": "OAUTH_RATE_LIMITER", "namespace_id": "1001",
    "simple": { "limit": 120, "period": 60 }
  }],
  "kv_namespaces": [{
    "binding": "OAUTH_KV", "id": "00000000000000000000000000000000"
  }],
  "d1_databases": [{
    "binding": "ACCOUNTS",
    "database_name": "example-accounts",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../site/migrations"
  }]
}
